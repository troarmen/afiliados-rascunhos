# ---------------------------------------------------------------------------
# PARE — Projeto Afiliado Rascunhos Econômicos
# Copie este arquivo para `.env.local` e preencha.
# Nenhuma variável é obrigatória para rodar em desenvolvimento:
# sem Supabase, as candidaturas são gravadas em `.data/candidaturas.json`.
# ---------------------------------------------------------------------------

# URL pública do site (SEO, sitemap, canonical, og:image e rodapé dos e-mails).
# O domínio próprio AINDA NÃO FOI COMPRADO: o valor abaixo é provisório e nenhum
# domínio aparece em texto visível do site. Trocar aqui resolve tudo de uma vez.
NEXT_PUBLIC_SITE_URL="https://duckaffiliate.com.br"

# --- Banco de candidatos (Supabase) ---------------------------------------
# Crie o projeto em supabase.com e rode `supabase/schema.sql` no SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=""
# Chave de serviço: NUNCA prefixar com NEXT_PUBLIC_. Só é lida no servidor.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket PRIVADO dos materiais de divulgação (criado pelo schema.sql).
# Só mude se o nome do bucket for outro.
MATERIAIS_BUCKET="materiais"

# --- Painel administrativo (/admin) ---------------------------------------
# Senha de acesso ao painel de triagem.
ADMIN_PASSWORD="troque-esta-senha"
# Segredo para assinar o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Notificações por e-mail (opcional, via Brevo) -------------------------
# Sem estas variáveis o site funciona normalmente, apenas não envia e-mails.
# A chave é a de API v3 (Brevo → SMTP & API → API keys), não a chave SMTP.
# O remetente de MAIL_FROM precisa ser um domínio autenticado na Brevo.
BREVO_API_KEY=""
MAIL_FROM="Duck Affiliate <contato@rascunhoseconomicos.com>"
# Destino interno do alerta de nova candidatura (não aparece para o candidato).
MAIL_TEAM="parceiros@rascunhoseconomicos.com"

# --- Analytics (opcional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=""

# --- Comunidade de parceiros ----------------------------------------------
# Convite da comunidade (Telegram, por decisão do cliente — ver docs/03).
# Vazio = nenhum convite aparece no e-mail de aprovação nem na área do parceiro.
# Use um link que NÃO EXPIRE: no Telegram, o link principal do grupo
# (t.me/+...) ou o @usuario público valem para sempre; links criados com
# limite de tempo ou de usos, não.
NEXT_PUBLIC_COMUNIDADE_URL=""
NEXT_PUBLIC_COMUNIDADE_PLATAFORMA="Telegram"

# --- Links operacionais ----------------------------------------------------
NEXT_PUBLIC_WHATSAPP="5500000000000"
NEXT_PUBLIC_HOTMART_URL="https://hotmart.com"
